{
  "version": 1,
  "name": "feedback-triage",
  "description": "Daily Beeline feedback sweep; steps: feedback-triage-steps",
  "summary": "Rank human pain and repeated feedback with the morning walk, then check released fixes the next day.",
  "roles": [
    "triager"
  ],
  "start": "notify",
  "handoffs": {
    "notify": {
      "does": "Tell reporters about fixes that merged since the last run.",
      "role": "triager",
      "requires": [
        "fixedPullRequests",
        "skipReason",
        "unnotifiedPullRequests"
      ],
      "on": {
        "notified": "verify",
        "skipped": "verify",
        "timeout": "failed"
      },
      "timeoutSeconds": 1800
    },
    "pull": {
      "does": "Read new feedback and rank it by problem.",
      "role": "triager",
      "requires": [
        "problems"
      ],
      "on": {
        "ranked": "adapters",
        "nothing_new": "adapters",
        "timeout": "failed"
      },
      "timeoutSeconds": 1800
    },
    "approve": {
      "does": "A person approves dispatching the ranked problems, or skips them.",
      "kind": "gate",
      "role": "triager",
      "requires": [
        "decision"
      ],
      "on": {
        "dispatch": "dispatch",
        "skip": "done"
      },
      "timeoutSeconds": 43200,
      "default": "skip"
    },
    "dispatch": {
      "does": "Open a fix corner for each approved problem.",
      "role": "triager",
      "requires": [
        "corners",
        "signals"
      ],
      "on": {
        "dispatched": "done",
        "timeout": "failed"
      },
      "timeoutSeconds": 1800
    },
    "done": {
      "does": "The sweep finished.",
      "kind": "terminal",
      "status": "done"
    },
    "failed": {
      "does": "The sweep stopped before it finished.",
      "kind": "terminal",
      "status": "failed"
    },
    "adapters": {
      "does": "Check latest ACP adapters without credentials and add versioned failures to this sweep.",
      "role": "triager",
      "requires": [
        "adapterFindings",
        "adapterResults",
        "skipReason"
      ],
      "on": {
        "checked": "present",
        "failed": "present",
        "timeout": "present"
      },
      "timeoutSeconds": 1800
    },
    "verify": {
      "does": "Check each dispatched signal after release and record whether it stopped.",
      "role": "triager",
      "requires": [
        "signalChecks"
      ],
      "on": {
        "checked": "pull",
        "timeout": "failed"
      },
      "timeoutSeconds": 1800
    },
    "present": {
      "does": "Merge feedback and the completed 6am walk into one list ranked by people affected.",
      "role": "triager",
      "requires": [
        "rankedProblems",
        "walkRunId"
      ],
      "on": {
        "presented": "approve",
        "nothing_to_build": "done",
        "timeout": "failed"
      },
      "timeoutSeconds": 1800
    }
  }
}
