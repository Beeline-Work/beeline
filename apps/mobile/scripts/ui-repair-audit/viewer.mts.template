import {createServer} from 'node:http';
import {mkdirSync,writeFileSync} from 'node:fs';
import {WebSocketServer} from 'ws';
import {chromium} from './node_modules/playwright-core/index.mjs';
import {migrate} from '../../apps/server/src/database.ts';
import {PgliteDatabase} from '../../apps/server/src/test-support.ts';
import {LiveHub} from '../../apps/server/src/live.ts';
import {SYSTEM_IDENTITY_ID} from '@beeline/api-contract/system-identity';
import * as before from '../../apps/server/src/computer-session.audit-before.ts';
import * as after from '../../apps/server/src/computer-session.ts';
const out='apps/mobile/evidence/ui-repair-audit';mkdirSync(out,{recursive:true});
const H='a'.repeat(64),A='b'.repeat(64),W='11111111-1111-4111-8111-111111111119',R='22222222-2222-4222-8222-222222222229';
const db=new PgliteDatabase(),live=new LiveHub();await migrate(db);
await db.query(`INSERT INTO identities(id,kind,name) VALUES($1,'human','Human'),($2,'agent','Agent'),($3,'human','System')`,[H,A,SYSTEM_IDENTITY_ID]);
await db.query(`INSERT INTO agents(agent_id,owner_id) VALUES($1,$2)`,[A,H]);await db.query(`INSERT INTO workspaces(id,name) VALUES($1,'Audit')`,[W]);await db.query(`INSERT INTO rooms(id,workspace_id,name) VALUES($1,$2,'Room')`,[R,W]);
await db.query(`INSERT INTO memberships(workspace_id,room_id,identity_id,role) VALUES($1,$2,$3,'member'),($1,$2,$4,'owner')`,[W,R,A,H]);await db.query(`INSERT INTO memberships(workspace_id,identity_id,role) VALUES($1,$2,'owner')`,[W,H]);
const upstream=createServer((q,r)=>r.writeHead(200,{'content-type':'text/html'}).end(`<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><style>html,body{margin:0;width:100%;height:100%;font:16px system-ui}body{display:flex;flex-direction:column;background:#101116}#screen{flex:1;min-height:0}#keyboard{position:fixed;left:-1000px}#bar{display:flex}#focus{width:42px;height:42px}#remote-keyboard{position:fixed;right:12px;bottom:160px;background:#5544dd;color:white;border:0;border-radius:50%;width:42px;height:42px}</style></head><body><div id="bar"><span id="state">Live</span><button id="focus">Keyboard</button></div><div id="screen"><canvas id="canvas" width="800" height="600" tabindex="0"></canvas></div><input id="keyboard"><script>const canvas=document.getElementById('canvas'),socket=new WebSocket(new URL("stream", location.href));function send(m){if(socket.readyState===1)socket.send(JSON.stringify(m))}function sendText(text){send({type:'text',text})}function point(){return{x:0,y:0}}document.getElementById('focus').onclick=()=>document.getElementById('keyboard').focus();const c=canvas.getContext('2d');c.fillStyle='#f5f5f5';c.fillRect(0,0,800,600);c.fillStyle='#202124';c.font='32px system-ui';c.fillText('Remote sign-in page',45,70);c.font='22px system-ui';c.fillText('Page content starts here',45,115);c.fillStyle='#5544dd';c.beginPath();c.arc(760,555,24,0,Math.PI*2);c.fill();c.fillStyle='white';c.fillText('⌨',745,562);</script></body></html>`));
const streams=new WebSocketServer({noServer:true});upstream.on('upgrade',(q,s,h)=>streams.handleUpgrade(q,s,h,c=>streams.emit('connection',c,q)));await new Promise(r=>upstream.listen(0,'127.0.0.1',r));
const browser=await chromium.launch({executablePath:'/usr/bin/google-chrome',headless:true,args:['--no-sandbox','--disable-dev-shm-usage']});
try {for(const [state,mod] of Object.entries(process.env.AUDIT_FIXED?{fixed:after}:{before,after})) {
 const server=createServer((q,r)=>{const u=new URL(q.url!,'http://localhost');const id=u.pathname.split('/')[2];if(u.pathname.endsWith('/status'))void mod.serveComputerStatus(q,r,db,id);else void mod.serveComputerSession(q,r,db,live,id)});server.on('upgrade',(q,s,h)=>{const id=q.url!.split('/')[2];void mod.upgradeComputerSession(q,s,h,db,live,id)});await new Promise(r=>server.listen(0,'127.0.0.1',r));
 const share=await mod.createComputerSession(db,live,{roomId:R,agentId:A,sessionId:`audit-${state}`,upstreamUrl:`http://127.0.0.1:${upstream.address().port}/s/${'p'.repeat(43)}/`},u=>u.hostname==='127.0.0.1');const access=await mod.computerViewToken(db,share.id,H);
 const page=await browser.newPage({viewport:{width:390,height:750},isMobile:true,hasTouch:true});const url=`http://127.0.0.1:${server.address().port}/s/${share.id}/?access=${access}&embedded=1`;await page.goto(url);await page.locator('#canvas').waitFor();await page.waitForTimeout(200);
 await page.screenshot({path:`${out}/page-${state}.png`});const initial=await page.locator('#canvas').boundingBox();
 await page.evaluate(()=>{const c=document.getElementById('canvas');c.dispatchEvent(new WheelEvent('wheel',{ctrlKey:true,deltaY:2000,clientX:195,clientY:300,bubbles:true,cancelable:true}))});await page.screenshot({path:`${out}/zoom-${state}.png`});
 if(state==='fixed') {
 await page.evaluate(()=>socket.dispatchEvent(new MessageEvent('message',{data:JSON.stringify({type:'navigation',url:'https://login.example/vnc.html'})})));
 const hidden=await page.locator('#bar').isHidden();if(!hidden)throw new Error('duplicate keyboard remains visible');
 await page.screenshot({path:`${out}/keyboard-remote-fixed.png`});
 await page.evaluate(()=>socket.dispatchEvent(new MessageEvent('message',{data:JSON.stringify({type:'navigation',url:'https://example.com/'})})));
 if(!await page.locator('#focus').isVisible())throw new Error('browser keyboard missing');
 await page.screenshot({path:`${out}/keyboard-browser-fixed.png`});
}
 const zoom=await page.locator('#canvas').boundingBox();const buttons=await page.locator('button').allTextContents();writeFileSync(`${out}/page-${state}.json`,JSON.stringify({initial,zoom,buttons},null,2));console.log(state,{initial,zoom,buttons});await page.close();await mod.endComputerSession(db,live,(await mod.getComputerSession(db,share.id))!);server.closeAllConnections();await new Promise(r=>server.close(r));
}}finally{await browser.close();for(const c of streams.clients)c.terminate();streams.close();upstream.closeAllConnections();upstream.close();await db.close()}
