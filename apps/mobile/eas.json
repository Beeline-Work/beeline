{
  "cli": {
    "version": "22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "production",
      "ios": {
        "credentialsSource": "local"
      },
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "production-apk": {
      "extends": "production",
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "beta-apk": {
      "extends": "production-apk",
      "channel": "beta",
      "env": {
        "EXPO_UPDATES_CHANNEL": "beta",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "89KT3SWYAF",
        "ascAppId": "6803948500",
        "appName": "Beeline - team workspaces",
        "bundleIdentifier": "app.usebeeline.mobile",
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "ascApiKeyId": "$EXPO_ASC_KEY_ID",
        "ascApiKeyIssuerId": "$EXPO_ASC_ISSUER_ID"
      }
    }
  }
}
