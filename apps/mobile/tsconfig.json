{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["react-native", "jest"],
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "App.tsx", "index.js", "__tests__/**/*"],
  "exclude": ["node_modules", "dist", "ios", "android"]
}
