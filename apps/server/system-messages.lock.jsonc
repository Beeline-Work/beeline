    "file": "apps/server/src/daemon-service.ts",
    "kind": "systemLine",
    "template": "systemLine(this.database, {\n    id: createHash('sha256').update(`link-approval:${requestId}`).digest('hex'),\n    roomId, authorId: SYSTEM_IDENTITY_ID,\n    subject: { kind: 'system', name: 'Link' },\n    verb: 'needs your approval for', object: title, consequence: detail,\n    presentation: 'card', cardType: 'squire-approval',\n    card: {\n        agent: { pubkey: agentId, kind: 'agent', name: context.agent_name,\n            ...(context.agent_handle ? { handle: context.agent_handle } : {}),\n            ...(context.agent_avatar ? { avatar: context.agent_avatar } : {}) },\n        tool: 'Link', title, detail, approvalUrl, approvalId: requestId,\n        linkKind: 'approval', sourceRoomId: input.roomId,\n        expiresAt: Date.now() + 24 * 60 * 60000,\n        ...(sourceMessageId ? { sourceMessageId } : {}),\n    },\n})",
    "literals": [
      "'/v1/connectors/logo/system.svg'",
      "':'",
      "'Link'",
      "'agent'",
      "'approval'",
      "'card'",
      "'hex'",
      "'needs your approval for'",
      "'sha256'",
      "'squire-approval'",
      "'system'",
      "`${(input.amount / 100).toFixed(2)} USD · ${input.description}`",
      "`${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`",
      "`INSERT INTO identities(id,kind,name,handle,hidden_from_roster,avatar)\n     VALUES ($1,'human',$2,$3,true,$4) ON CONFLICT(id) DO UPDATE\n     SET name=EXCLUDED.name,handle=EXCLUDED.handle,hidden_from_roster=true,\n         avatar=EXCLUDED.avatar,updated_at=now()`",
      "`INSERT INTO memberships(workspace_id,room_id,identity_id,role)\n       VALUES ($1,$2,$3,'member')\n       ON CONFLICT (room_id,identity_id) WHERE room_id IS NOT NULL\n       DO UPDATE SET removed_at=NULL`",
      "`INSERT INTO rooms(id,workspace_id,created_by,name,visibility,direct_participants)\n     VALUES ($1,$2,$3,'Direct message','invite-only',$4::jsonb)\n     ON CONFLICT(id) DO NOTHING RETURNING id`",
      "`Link purchase at ${input.merchant}`",
      "`SELECT room.workspace_id,identity.name agent_name,identity.handle agent_handle,\n        identity.avatar agent_avatar FROM rooms room JOIN identities identity ON identity.id=$2\n       WHERE room.id=$1`",
      "`UPDATE rooms SET visibility='invite-only' WHERE id=$1`",
      "`buzz-dm:v1:${workspaceId}:${participants.join(':')}`",
      "`link-approval:${requestId}`"
    ],
    "occurrences": 1
  },
