createRoot(document.getElementById('root')!).render(<Proof />);
setTimeout(() => {
  if (section === 'repoPending')
    (document.querySelector('[data-testid="audit-repo-add-account"]') as HTMLElement)?.click();
  if (section === 'voice')
    (document.querySelector('[data-testid="change-agent-voice"]') as HTMLElement)?.click();
  if (section === 'composeMenu')
    (document.querySelector('[data-testid="room-deck-compose-fab"]') as HTMLElement)?.click();
}, 300);
setTimeout(() => {
  const root = document.getElementById('root')!;
  const text = root.textContent ?? '';
  const checks: Record<string, boolean> = { [section]: text.length > 0 };
  document.getElementById('result')!.textContent = checks[section]
    ? `PASS ${section}`
    : `FAIL ${section}: ${text}`;
  const metrics = [...root.querySelectorAll('[data-testid], [role="button"], [role="link"]')].map(
    (el) => {
      const r = el.getBoundingClientRect();
      const c = getComputedStyle(el);
      return {
        id: el.getAttribute('data-testid') || el.getAttribute('aria-label'),
        text: el.textContent,
        x: r.x,
        y: r.y,
        width: r.width,
        height: r.height,
        font: c.fontSize,
        line: c.lineHeight,
      };
    },
  );
  document.getElementById('result')!.textContent = JSON.stringify({
    section,
    metrics,
    text,
    boxes: [...root.querySelectorAll('[dir="auto"]')].map((el) => {
      const r = el.getBoundingClientRect(),
        c = getComputedStyle(el);
      return {
        text: el.textContent,
        x: r.x,
        y: r.y,
        width: r.width,
        height: r.height,
        font: c.fontSize,
        line: c.lineHeight,
      };
    }),
    errors: (window as any).__console,
  });
}, 700);
