{
  "name": "@beeline/body",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "beeline": "./dist/cli.js",
    "beeline-readonly-mcp": "./dist/read-only-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./helper-status": {
      "types": "./dist/helper-status.d.ts",
      "import": "./dist/helper-status.js",
      "default": "./dist/helper-status.js"
    }
  },
  "scripts": {
    "body": "node --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "measure:turns": "node --import tsx scripts/measure-turn-phases.ts",
    "prove:codex-prompt-delivery": "node --import tsx scripts/prove-codex-prompt-delivery.ts",
    "measure:fast-resume": "node --import tsx scripts/measure-fast-resume.ts",
    "pretest:live": "npm run build -w @beeline/nostr && npm run build -w @beeline/api-contract && npm run build -w @beeline/body",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@beeline/api-contract": "*",
    "@beeline/nostr": "*",
    "@clack/prompts": "^1.7.0",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@sentry/node": "^10.76.2",
    "pi-mcp-adapter": "2.30.0",
    "picocolors": "^1.1.1",
    "quota-axi": "0.1.64",
    "smol-toml": "1.8.0",
    "typebox": "1.3.20",
    "ws": "^8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
