[Unit]
Description=Root-only registration socket for isolated CI runners
Before=beeline-ci-shard-1.service beeline-ci-shard-2.service

[Socket]
ListenStream=/run/beeline-ci-registration/relay.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0700
Accept=no
RemoveOnStop=yes
ExecStartPre=/usr/bin/python3 /usr/local/lib/beeline-ci/broker.py --cleanup-stale

[Install]
WantedBy=sockets.target
