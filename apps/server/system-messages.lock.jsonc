    "template": "database.query(`UPDATE messages SET card=COALESCE(card,'{}'::jsonb) || jsonb_build_object('trigger',jsonb_build_object('scheduleId',$2::text,'period',$3::text)) || $4::jsonb WHERE id=$1`, [\n    messageId,\n    current.id,\n    current.next_run_at.toISOString(),\n    JSON.stringify(current.owner_id ? { ownerId: current.owner_id } : {}),\n])",
