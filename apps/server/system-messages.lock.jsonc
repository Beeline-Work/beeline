      "`SELECT id,kind,name,handle FROM identities WHERE id=ANY($1::text[])`",
      "`SELECT pg_advisory_xact_lock(hashtext($1))`",
      "`SELECT room.name,fact.lifecycle->'pr'->>'mergeCommitSha' merge_sha FROM rooms room LEFT JOIN corner_facts fact ON fact.corner_id=room.id WHERE room.id=$1`",
      "`SELECT session.id session_id,message.text FROM messages message\n       JOIN computer_sessions session ON session.id=message.system_event->'payload'->>'sessionId'\n       WHERE message.id=$1 AND session.room_id=$2 AND session.status='live'\n       FOR UPDATE OF session`",
      "`SELECT subscription.id,subscription.agent_id,subscription.prompt,subscription.workflow_slug\n          FROM agent_subscriptions subscription JOIN memberships member\n            ON member.room_id=subscription.room_id AND member.identity_id=subscription.agent_id\n            AND member.removed_at IS NULL\n          WHERE subscription.room_id=$1 AND subscription.source='room' AND subscription.event=$2\n          ORDER BY subscription.id\n          FOR UPDATE OF subscription`",
      "`SELECT w.watcher_room_id,w.agent_id,to_jsonb(incoming) incoming_command FROM corner_watches w\n           LEFT JOIN agent_commands incoming ON incoming.id=w.incoming_command_id\n           JOIN rooms corner ON corner.id=w.corner_id AND corner.parent_id IS NOT NULL\n           JOIN rooms watcher ON watcher.id=w.watcher_room_id AND watcher.archived_at IS NULL\n           JOIN memberships m ON m.room_id=w.watcher_room_id AND m.identity_id=w.agent_id\n             AND m.removed_at IS NULL\n           WHERE w.corner_id=$1 AND w.kinds @> $2::jsonb\n             AND ($3::text IS NULL OR w.agent_id<>$3)\n             AND EXISTS(SELECT 1 FROM memberships target WHERE target.room_id IN (corner.id,corner.parent_id)\n               AND target.identity_id=w.agent_id AND target.removed_at IS NULL)\n           FOR SHARE OF w,m,watcher`",
      "`Sign in to ${AGENT_SIGN_IN_SERVICE_LABELS[field('harness') as AgentSignInHarness] ?? field('harness')}?`",
      "`Sign in to ${field('name')}?`",
      "`UPDATE agent_commands SET recovery_context=$2 WHERE id=$1`",
      "`UPDATE agent_commands SET source_message_id=$2,\n             recovery_context=right(COALESCE(recovery_context || E'\\\\n','') || $3,16000)\n           WHERE id=$1 AND state='pending'`",
      "`UPDATE agent_commands SET state=$4,completed_at=now() WHERE room_id=$1 AND agent_id=$2 AND turn_request_id=$3 AND state IN ('pending','claimed')`",
      "`UPDATE agent_subscriptions\n            SET last_fired_at=now(),fired_count=fired_count+1 WHERE id=$1`",
      "`Watched corner ${watched?.name ?? input.subject.name} (${input.card?.cornerId ?? input.roomId}): ${input.kind === 'corner-opened' ? 'opened' : input.kind}${input.kind === 'merged' && watched?.merge_sha ? ` · merge commit ${watched?.merge_sha}` : ''}\\n${text}`",
      "`[corner-lifecycle] ${cornerId}: ignored ${event.kind} in ${state ?? 'no run'}: ${why}`",
      "`\\n${input.wakeNote}`",
      "`agent-lifecycle:${sourceId}:${target.agent_id}:denied`",
      "`commander-wakes:${roomId}:${agentId}`",
      "`did not ${action}`",
      "`did not sign in to ${AGENT_SIGN_IN_SERVICE_LABELS[loginHarness]}`",
      "`room-subscription:${id}:${subscription.id}`",
      "`workflow-run:${runId}`"
    ],
    "occurrences": 1
  },
  {
    "id": "src/agent-command.ts:routeTaggedLifecycleCommand:wrapper:9231f724276cc9ce",
    "file": "apps/server/src/agent-command.ts",
    "kind": "wrapper",
    "template": "dropQueuedOrdersForStop(db, parent)",
    "literals": [
      "`SELECT * FROM agent_commands WHERE id=$1 FOR UPDATE`",
      "`SELECT agent.agent_id,agent.owner_id,agent.harness,identity.handle,identity.name,\n         sender.role room_role,agent.access_policy,\n         presence.body->>'lifecycleId' lifecycle_id,\n         presence.body->>'releaseVersion' release_version,\n         presence.body->>'sourceSha' source_sha,\n         presence.body->>'status' presence_status,presence.updated_at presence_updated_at,\n         presence.body->>'held'='true' presence_held\n       FROM agents agent\n       JOIN identities identity ON identity.id=agent.agent_id\n       JOIN memberships target_member ON target_member.room_id=$2\n         AND target_member.identity_id=agent.agent_id AND target_member.removed_at IS NULL\n       JOIN memberships sender ON sender.room_id=$2\n         AND sender.identity_id=$3 AND sender.removed_at IS NULL\n       LEFT JOIN LATERAL (\n         SELECT body,updated_at FROM live_outputs\n         WHERE agent_id=agent.agent_id AND kind='presence'\n         ORDER BY updated_at DESC LIMIT 1\n       ) presence ON true\n       WHERE agent.agent_id=$1\n       FOR SHARE OF agent,target_member,sender`",
      "`SELECT turn.request_id,command.id command_id,command.root_source_message_id,\n         root.author_id requested_by\n       FROM agent_turns turn\n       JOIN agent_commands command ON command.room_id=turn.room_id\n         AND command.agent_id=turn.agent_id AND command.turn_request_id=turn.request_id\n         AND command.action IN ('input','resume')\n       JOIN messages root ON root.id=command.root_source_message_id\n       WHERE turn.room_id=$1 AND turn.agent_id=$2 AND turn.status='working'\n       ORDER BY turn.created_at DESC,command.created_at DESC LIMIT 1`"
    ],
    "occurrences": 1
  },
