// Squire agent account only. A fixed updater is the sole additional operation.
polkit.addRule(function(action, subject) {
    if (subject.user !== "lunchbox") return polkit.Result.NOT_HANDLED;
    if (action.id === "org.freedesktop.systemd1.manage-unit-files" ||
        action.id === "org.freedesktop.systemd1.set-environment") return polkit.Result.NO;
    if (action.id !== "org.freedesktop.systemd1.manage-units") return polkit.Result.NOT_HANDLED;
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    var units = ['beeline-ci-registration.service', 'beeline-ci-registration.socket', 'beeline-ci-shard-1-docker.service', 'beeline-ci-shard-1.service', 'beeline-ci-shard-2-docker.service', 'beeline-ci-shard-2.service', 'beeline-ci-shard-3-docker.service', 'beeline-ci-shard-3.service', 'beeline-ci-shard-4-docker.service', 'beeline-ci-shard-4.service'];
    if (unit === "beeline-ci-sync.service" && verb === "start") return polkit.Result.YES;
    if (units.indexOf(unit) !== -1 && ["start", "stop", "restart"].indexOf(verb) !== -1)
        return polkit.Result.YES;
    return polkit.Result.NO;
});
