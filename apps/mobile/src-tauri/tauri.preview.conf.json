{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beeline Preview",
  "identifier": "app.usebeeline.desktop.preview",
  "build": {
    "beforeDevCommand": "npx expo start --web --port 8081",
    "beforeBuildCommand": "npx expo export --platform web --output-dir dist --clear",
    "devUrl": "http://localhost:8081",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Beeline Preview",
        "width": 1280,
        "height": 840,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true
      }
    ]
  }
}
