@@ -0,0 +1,7 @@
+const escape = value => String(value).replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[c]);
+const labels = { welcome_shown:'Welcome shown', welcome_skipped:'Welcome skipped', option_picked:'First choice', user_answered:'Sent a message', task_question:'Task asked', task_first_answer:'Draft answer', task_review_requested:'Second opinion requested', task_final_answer:'Final answer', game_posted:'Game posted', game_viewer_opened:'Game opened', game_viewer_closed:'Game closed', invite_created:'Invite created', invite_shared:'Invite shared', invite_opened:'Invite opened', invite_friend_signed_up:'Friend signed up', invite_friend_messaged:'Friend messaged', returned_day_1:'Messaged after a day', returned_day_7:'Messaged after a week' };
+const duration = value => Number.isFinite(value) ? value < 1000 ? `${Math.round(value)} ms` : `${(value / 1000).toFixed(1)} s` : '—';
+export function renderOnboarding(value) {
+  if (!value?.splits) return '';
+  return `<section class="d-section"><p class="d-kicker">Onboarding</p><h2>From welcome to first value</h2><p class="d-meta">Welcome cohort ${escape(value.from)}–${escape(value.through)}. Counts are signup attempts. Each branch follows its own path; first-choice splits keep D even if the person later plays.</p>${value.splits.map(split => `<details ${split.option === 'all' ? 'open' : ''}><summary>${escape(split.option === 'all' ? 'All choices' : split.option === 'unpicked' ? 'No choice yet' : `First choice ${split.option}`)}</summary><div class="d-funnel">${split.steps.map(step => `<div class="d-row"><span>${escape(labels[step.event] ?? step.event)}<small>${step.previousEvent ? `Median from ${escape(labels[step.previousEvent] ?? step.previousEvent).toLowerCase()}: ${duration(step.medianTimeMs)}` : 'Starting point'}${step.medianDurationMs !== null ? ` · Time in viewer: ${duration(step.medianDurationMs)}` : ''}</small></span><b>${Number.isFinite(step.count) ? step.count.toLocaleString('en-US') : '—'}</b></div>`).join('')}</div></details>`).join('')}</section>`;
+}
