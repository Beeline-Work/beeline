{
  "name": "@beeline/buzz-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:build-clean": "mkdir -p dist/read-model && touch dist/read-model/stale && npm run build && test ! -e dist/read-model/stale",
    "format:check": "prettier --check src scripts package.json README.md",
    "lint": "npm run format:check",
    "capture:relay-corpus": "node --import tsx scripts/capture-relay-history.ts",
    "pretest:live": "npm run build -w @beeline/nostr && npm run build -w @beeline/api-contract && npm run build -w @beeline/buzz-client",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@beeline/api-contract": "*",
    "@beeline/nostr": "*",
    "@noble/hashes": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "fast-check": "^4.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
