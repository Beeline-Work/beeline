{
  "name": "@beeline/body",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "beeline": "./dist/cli.js",
    "beeline-readonly-mcp": "./dist/read-only-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./release-status": {
      "types": "./dist/release-status.d.ts",
      "import": "./dist/release-status.js",
      "default": "./dist/release-status.js"
    }
  },
  "scripts": {
    "body": "node --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pretest:live": "npm run build -w @beeline/nostr && npm run build -w @beeline/api-contract && npm run build -w @beeline/body",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@beeline/api-contract": "*",
    "@beeline/nostr": "*",
    "@clack/prompts": "^1.7.0",
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "pi-mcp-adapter": "2.30.0",
    "picocolors": "^1.1.1",
    "typebox": "1.3.20"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
