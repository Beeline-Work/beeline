{
  "name": "buzzy",
  "version": "0.0.0",
  "private": true,
  "description": "The merge you hold from your phone. See spec.md.",
  "workspaces": [
    "apps/api",
    "apps/auth",
    "apps/body",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:invite-web": "esbuild web/join/invite-source.js --bundle --format=iife --minify --platform=browser --target=es2022 --outfile=web/join/invite.js",
    "lint": "npm run lint:typecheck && npm run lint:shell && npm run lint:workflows && npm run lint:referenced-paths",
    "lint:ui-components": "node scripts/check-mobile-ui-components.mjs",
    "lint:phone-network": "node scripts/check-phone-network-channels.mjs",
    "test:phone-network": "node --test scripts/phone-network-channels.test.mjs",
    "lint:typecheck": "npm run typecheck",
    "lint:shell": "git ls-files -z -- '*.sh' | xargs -0 shellcheck",
    "lint:workflows": "docker run --rm --user 0 -v \"$PWD:/repo\" -w /repo ghcr.io/beeline-work/ci-actionlint:1.7.7@sha256:887a259a5a534f3c4f36cb02dca341673c6089431057242cdc931e9f133147e9 -config-file .github/actionlint.yaml",
    "lint:referenced-paths": "node scripts/verify-referenced-paths.mjs && node --test scripts/verify-referenced-paths.test.mjs",
    "dead-code:prepare": "turbo run build",
    "predead-code": "npm run dead-code:prepare",
    "dead-code": "node scripts/check-dead-code.mjs",
    "predead-code:baseline": "npm run dead-code:prepare",
    "dead-code:baseline": "node scripts/check-dead-code.mjs --write-baseline",
    "typecheck": "turbo run typecheck && npm run typecheck --prefix apps/mobile && tsc -p tsconfig.scripts.json",
    "test": "turbo run test",
    "feedback:group": "node scripts/feedback-signals.mjs",
    "test:feedback-signals": "node --test scripts/feedback-signals.test.mjs",
    "prove:onboarding": "node scripts/onboarding-walkthrough.mjs",
    "prove:free-agent:docker-machines": "node scripts/free-agent-docker-machines.mjs",
    "review:exact-head": "node scripts/review-exact-head.mjs",
    "prompt-cases": "node --import tsx scripts/prompt-cases.ts",
    "prompt:nightly": "node --import tsx scripts/prompt-nightly.mjs",
    "test:prompt-cases": "node --import tsx scripts/prompt-cases.ts",
    "test:deploy": "node --test scripts/unified-release.test.mjs scripts/release-channel.test.mjs scripts/npm-package-visibility.test.mjs scripts/smoke-helper-package.test.mjs scripts/release-artifact-allowlist.test.mjs",
    "test:web-deploy": "node --test scripts/verify-web-deployment.test.mjs",
    "check:app-association-drift": "node scripts/check-app-association-drift.mjs",
    "test:play": "node --test scripts/play-token.test.mjs",
    "install:beeline": "bash scripts/install-beeline.sh",
    "bundle:beeline": "node scripts/build-beeline-bundle.mjs",
    "verify:beeline-install": "node scripts/verify-beeline-install.mjs",
    "measure:agent-tools": "node --import tsx scripts/measure-agent-tool-surface.ts",
    "measure:corner-wake": "node --import tsx scripts/measure-corner-wake.ts",
    "mobile:install": "npm install --prefix apps/mobile",
    "corner:prepare": "node scripts/prepare-corner.mjs",
    "game-host": "node scripts/runnable-artifact-proxy.mjs",
    "mobile:web": "npm run web --prefix apps/mobile",
    "mobile:typecheck": "npm run typecheck --prefix apps/mobile",
    "prompt:discovery": "node --import tsx scripts/discovery-live.mjs",
    "test:prompt-discovery": "node --import tsx --test scripts/discovery-launch.test.mjs",
    "build:x-attribution": "esbuild web/x-attribution-source.ts --bundle --format=iife --minify --platform=browser --target=es2022 --outfile=web/x-attribution.js",
    "backfill:luna": "node scripts/backfill-luna.mjs",
    "lint:router": "node scripts/check-router-boundaries.mjs",
    "codecs:generate": "node scripts/generate-network-codecs.mjs",
    "codecs:check": "node scripts/generate-network-codecs.mjs --check",
    "test:router-boundaries": "node --test scripts/router-boundaries.test.mjs"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "^1.6.0",
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.1",
    "js-tiktoken": "1.0.21",
    "knip": "^5.88.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "npm@10.8.0"
}
