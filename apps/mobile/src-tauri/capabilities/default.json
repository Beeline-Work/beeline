{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Beeline web bundle is allowed to ask the desktop shell for.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:webview:allow-set-webview-zoom",
    "deep-link:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://usebeeline.app/*" },
        { "url": "https://server.usebeeline.app/*" },
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" }
      ]
    }
  ]
}
