{
  "name": "buzzy",
  "version": "0.0.0",
  "private": true,
  "description": "The merge you hold from your phone. See spec.md.",
  "workspaces": [
    "apps/api",
    "apps/auth",
    "apps/body",
    "apps/gate",
    "apps/push-gateway",
    "apps/server",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:invite-web": "esbuild relay-stack/web/join/invite-source.js --bundle --format=iife --minify --platform=browser --target=es2022 --alias:@beeline/buzz-client=./packages/buzz-client/src/index.ts --alias:@beeline/nostr=./packages/nostr/src/index.ts --outfile=relay-stack/web/join/invite.js",
    "lint": "npm run lint:typecheck && npm run lint:shell && npm run lint:workflows",
    "lint:typecheck": "npm run typecheck",
    "lint:shell": "git ls-files -z -- '*.sh' | xargs -0 shellcheck",
    "lint:workflows": "docker run --rm --user 0 -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.7 -config-file .github/actionlint.yaml",
    "typecheck": "turbo run typecheck && npm run typecheck --prefix apps/mobile && tsc -p tsconfig.scripts.json",
    "test": "turbo run test",
    "stack:up": "docker compose -f relay-stack/compose.yml up -d --build",
    "stack:down": "docker compose -f relay-stack/compose.yml down -v",
    "verify:local-room-indexer": "npm run build -w @beeline/nostr && npm run build -w @beeline/api-contract && npm run build -w @beeline/buzz-client && node --import tsx scripts/verify-local-room-indexer.ts",
    "prove:private-pairing": "npm run build -w @beeline/nostr && npm run build -w @beeline/api-contract && npm run build -w @beeline/buzz-client && node --import tsx scripts/prove-private-pairing.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "test:deploy": "node --test scripts/deploy-relay-host.test.mjs scripts/landing-page.test.mjs scripts/publish-beeline-dl.test.mjs",
    "install:beeline": "bash scripts/install-beeline.sh",
    "bundle:beeline": "node scripts/build-beeline-bundle.mjs",
    "verify:beeline-install": "node scripts/verify-beeline-install.mjs",
    "mobile:install": "npm install --prefix apps/mobile",
    "mobile:web": "npm run web --prefix apps/mobile",
    "mobile:typecheck": "npm run typecheck --prefix apps/mobile"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "npm@10.8.0"
}
