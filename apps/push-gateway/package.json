{
  "name": "@beeline/push-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./projection": {
      "types": "./dist/room-indexer-projection.d.ts",
      "import": "./dist/room-indexer-projection.js",
      "default": "./dist/room-indexer-projection.js"
    }
  },
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "audit:suppression": "tsx scripts/audit-suppression.ts",
    "verify:live": "tsx deploy/verify-live.ts"
  },
  "dependencies": {
    "@beeline/api-contract": "*",
    "@beeline/body": "*",
    "@beeline/buzz-client": "*",
    "@beeline/nostr": "*",
    "firebase-admin": "^13.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
