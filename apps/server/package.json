{
  "name": "@beeline/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "node dist/index.js --migrate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "measure": "node --import tsx src/measure-cli.ts",
    "memory:audit": "node --import tsx src/institutional-memory-audit.ts",
    "repro:shared-browser": "node --import tsx scripts/shared-browser-repro.ts",
    "email:art": "node scripts/generate-email-art.mjs",
    "prove:checkin-email": "node --import tsx scripts/prove-checkin-email.mjs"
  },
  "dependencies": {
    "@beeline/api-contract": "*",
    "@beeline/auth": "*",
    "@livekit/rtc-node": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sentry/node": "^10.76.2",
    "aws4fetch": "^1.0.20",
    "cron-parser": "^5.10.0",
    "firebase-admin": "^13.4.0",
    "ipaddr.js": "^2.5.0",
    "livekit-server-sdk": "^2.19.1",
    "pg": "^8.23.0",
    "sharp": "^0.34.5",
    "tldts": "^7.4.18",
    "typebox": "1.3.20",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "standardwebhooks": "^1.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
