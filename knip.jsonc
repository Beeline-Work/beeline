{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // This gate owns dead source only. Dependency declarations, shell binaries,
  // unresolved platform modules, duplicate exports, and enum members have
  // separate manifests/toolchains and are intentionally outside its contract.
  "include": ["files", "exports", "types"],
  "includeEntryExports": true,
  "ignoreExportsUsedInFile": true,
  // Only proof adapters: bundlers supply these exports through runtime aliases.
  // Keep file reachability and production export enforcement enabled.
  "ignoreIssues": {
    // Metro selects the fitted web title implementation through this platform export.
    "apps/mobile/sources/buzz/use-autofit-text.web.ts": ["exports"],
    // The local GitHub card proof resolves these exports through temporary Metro aliases.
    "apps/mobile/scripts/github-card-proof-{adapters.tsx,metro.cjs}": ["exports"],
    // Metro injects these disposable server/router adapters into the native proof.
    "apps/mobile/scripts/search-cell-proof/mocks.tsx": ["exports"],
    // Selected as the temporary Metro configuration described in the proof runbook.
    "apps/mobile/scripts/search-cell-proof/metro.cjs": ["exports"],
    // Type declarations for the JavaScript boundary shared by Expo Go and the
    // rendered-page test; the runtime module is selected through boundary aliases.
    "apps/mobile/offline-proof/adapters/services.d.ts": ["exports"],
    // The Trusty Squire native proof resolves these through its temporary Metro adapter.
    "apps/mobile/scripts/proof-shims/*.{ts,tsx,cjs}": ["exports", "types"],
    "apps/mobile/scripts/ui-alignment-proof/{proof-env,proof-workbench,svg,unistyles}.{ts,tsx}": ["exports"],
  },
  "workspaces": {
    ".": {
      // Shell hooks and device harnesses invoke these by path, outside the
      // JavaScript module graph Knip can follow.
      "entry": [
        // Discovery spawns launch/MCP helpers; its runbook invokes the grading CLI by path.
        "scripts/discovery-{launch,mcp,grade}.mjs",
        "scripts/cutover-hooks/{generate-daemon-exchanges,production-e2e}.mjs",
        "scripts/prove-tray-inline.ts",
        "scripts/prove-agent-usage-refresh.mjs",
        // VAULT-CARD-1 invokes the isolated built-server/Squire proof by path.
        "scripts/prove-vault-save.mjs",
        // Usage truth live proof: two agents on one real login, run by path.
        "scripts/prove-usage-accounts.mjs",
        // The background latency runbook invokes these isolated database proofs by path.
        "scripts/prove-background-waste.mjs",
        "scripts/prove-webhook-burst.mjs",
        "scripts/cleanup-legacy-daemon-chat.ts",
        "scripts/prove-harness-node-path.mjs",
        "scripts/prove-corner-startup.mjs",
        // Reproduction CONNECTORS-1 invokes the built local PhoneService proof by path.
        "scripts/prove-connectors-cleanup.mjs",
        // Reproduction IDLE-1 invokes the isolated built-service proof by path.
        "scripts/prove-idle-corner.mjs",
        // Reproduction STALE-CAUSE-1 invokes the isolated HTTP proof by path.
        "scripts/prove-stale-wake-drop.mjs",
        "scripts/prove-corner-stall.mjs",
        // The development guide invokes the built storage retention proof by path.
        "scripts/prove-corner-proof-retention.mjs",
        // The dashboard runbook invokes the recorded Cloudflare HTTP proof by path.
        "scripts/prove-x-site-visits.mjs",
        "scripts/check-acp-adapters.mjs",
        "scripts/prove-voice-mode.ts",
        "scripts/prove-voice-call-errors.ts",
        "scripts/prove-voice-delivery.ts",
        "scripts/prove-voice-search.ts",
        "scripts/prove-voice-budget.ts",
        "scripts/prove-voice-keep-awake.ts",
        "scripts/prove-voice-multiparty.ts",
        "scripts/prove-multi-human-silence.ts",
        "scripts/prove-voice-multi-routing.ts",
        "scripts/prove-voice-tls.mjs",
        "scripts/serve-voice-ui-proof.ts",
        "scripts/serve-voice-room-review.ts",
        "scripts/helper-proof/prove-linux.mjs",
        "scripts/prove-helper-migration-update.mjs",
        // CI and the local Android runner invoke these tools by path.
        "scripts/latency-rig/*.{mjs,cjs}",
        // The transcript benchmark README invokes these measurement CLIs by path.
        "scripts/transcript-speed/{capture-*,seed,serve,inspect-web,reset,report,symbolicate-room-profile,list-engine-report,list-visual-audit,prepare-list-engines}.mjs",
      ],
      "project": [
        "scripts/**/*.{js,cjs,mjs,ts,tsx}",
        "!scripts/fixtures/dead-code-regression/**",
        ".verification/**/*.ts",
        "web/**/*.{js,mjs}",
        "!web/join/invite.js",
        // Generated browser bundle; source is web/x-attribution-source.ts.
        "!web/x-attribution.js",
      ],
    },
    "apps/*": {
      "project": [
        "src/**/*.{js,cjs,mjs,ts,tsx}",
        "scripts/**/*.{js,cjs,mjs,ts,tsx}",
        "deploy/**/*.{js,cjs,mjs,ts,tsx}",
        "*.config.{js,cjs,mjs,ts}",
      ],
    },
    "packages/*": {
      "project": ["src/**/*.{js,cjs,mjs,ts,tsx}", "scripts/**/*.{js,cjs,mjs,ts,tsx}"],
    },
    "apps/mobile": {
      // Expo's plugin evaluator cannot model this app's tuple-shaped config
      // plugins or its environment-gated branches. The config itself and the
      // filesystem router are represented explicitly below, so both branches
      // stay in the static graph without executing a CI-specific environment.
      "expo": false,
      "entry": [
        "index.ts",
        // The approved GitHub card proof uses temporary native/web entry and resolver overrides.
        "scripts/github-card-proof.tsx",
        // Gradle selects the Rooms connector native proof through entryFile.
        "scripts/rooms-mcp-native-proof.tsx",
        // Selected as the temporary Metro entry by evidence/connector-byline/README.md.
        "scripts/connector-byline-native-proof.tsx",
        // Reproduction CONNECTORS-1 selects this native Connectors proof as the Metro entry.
        "scripts/connectors-cleanup-native-proof.tsx",
        "scripts/github-card-proof-metro.cjs",
        // The card-button runbook invokes the renderer and selects the native Metro entry by path.
        "scripts/render-card-buttons.mjs",
        "scripts/card-button-gallery.tsx",
        "scripts/card-buttons-native-proof.tsx",
        // evidence/trusty-squire-connect/README.md selects this native entry and Metro adapter by path.
        "scripts/trusty-squire-native-proof.tsx",
        "scripts/proof-shims/*.{ts,tsx,cjs}",
        // The artifact-card footer restore selects this native Metro entry by path.
        "scripts/artifact-card-native-proof.tsx",
        // The desktop proportions evidence runbook invokes these standalone proof tools by path.
        "scripts/desktop-proportions-browser-proof.cjs",
        "scripts/desktop-proportions-native-fixture.cjs",
        "app.config.js",
        "sources/app/**/*.{ts,tsx}",
        "sources/**/*.{ios,android,windows,web,native,default}.{js,jsx,ts,tsx}",
        "scripts/{ota-delivery-index,ota-release}.mjs",
        // The screenshot builder loads its entry and native adapters through esbuild aliases.
        "scripts/ui-alignment-proof/*.{mjs,tsx,ts}",
        "scripts/{identity-axis-proof,identity-axis-proof-shims}.tsx",
        "scripts/emoji-clip-proof.tsx",
        // member-sheets.browser.test.ts bundles this browser entry by path through esbuild.
        "scripts/member-sheets-browser-proof.tsx",
        // label-sweep-proof.browser.test.ts bundles this browser entry by path through esbuild.
        "scripts/label-sweep-components-proof.tsx",
        "scripts/ui-repair-audit/prepare.mjs",
        "scripts/render-waveform-proof.mjs",
        // Documented browser proof bundles the real webhook subscription screen.
        "scripts/render-subscription-webhook-proof.mjs",
        "scripts/subscription-webhook-proof/*.{mjs,tsx}",
        "scripts/room-viewport-proof.tsx",
        "scripts/viewer-dock-overflow-{proof,native}.tsx",
        "scripts/viewer-dock-keyboard-native.tsx",
        // Gradle bundles the viewer composer screenshot fixture via entryFile.
        "scripts/viewer-composer-polish-native.tsx",
        // The native status fixture is bundled through Gradle's entryFile override.
        "scripts/status-band-native-entry.js",
        "scripts/unread-controls-native-proof.tsx",
        "scripts/operation-deadline-native-proof.tsx",
        "scripts/unread-dot-clear-proof.tsx",
        "scripts/jump-disc-proof.mjs",
        "scripts/reply-recovery-proof.mjs",
        "scripts/workspace-picture-clip-proof.tsx",
        "scripts/workspace-picture-seat-proof.tsx",
        "scripts/workspace-room-join-proof.tsx",
        "scripts/workspace-fix-sweep-proof.tsx",
        "scripts/workbench-keys-proof.tsx",
        "scripts/render-workbench-keys-proof.mjs",
        "scripts/{render-room-reply-notes-proof.mjs,room-reply-notes-proof.tsx}",
        "scripts/render-squire-wallet-freshness-proof.mjs",
        "scripts/squire-wallet-freshness-proof.tsx",
        "scripts/squire-wallet-freshness-fixtures.ts",
        // Selected as the temporary native entry for the Android approval card proof.
        "scripts/squire-approval-native-proof.tsx",
        // The vault card evidence runbook selects this temporary Metro entry.
        "scripts/vault-save-native-proof.tsx",
        "scripts/identity-picture-seat-proof.tsx",
        "scripts/identity-picture-seat-frames.tsx",
        "scripts/render-identity-picture-seat-frames.mjs",
        "scripts/computer-session-frame.tsx",
        "scripts/render-computer-session-frame.mjs",
        "scripts/transcript-dates-proof.tsx",
        // The shared UI library screenshots load these through esbuild and Gradle entry files.
        "scripts/{render-shared-ui-library-proof.mjs,shared-ui-library-native-entry.tsx,shared-ui-library-web-entry.tsx,shared-ui-library-proof.tsx,shared-ui-library-proof-new.tsx}",
        "scripts/tool-output-sheet-proof.tsx",
        "scripts/direct-message-picker-proof.tsx",
        "scripts/dm-sheet-proof.tsx",
        "scripts/beeline-mark-proof.tsx",
        "scripts/identity-mark-system-proof.tsx",
        "scripts/system-lines-proof.tsx",
        // The delivery-banner browser regression bundles this entry by path through esbuild.
        "scripts/error-banner-browser-proof.tsx",
        "scripts/failed-error-rows-proof.tsx",
        // The icon-order browser regression bundles this entry by path through esbuild.
        "scripts/button-icon-order-browser-proof.tsx",
        // The repository subscription screenshot runner bundles this entry by path.
        "scripts/repository-subscription-proof.tsx",
        "scripts/harness-start-failure-proof.tsx",
        "scripts/pr-accordion-proof.tsx",
        // Gradle bundles this native screenshot fixture through its entryFile override.
        "scripts/corner-pr-cards-native-proof.tsx",
        // Screenshot capture bundles these entries by path through esbuild and Gradle.
        "scripts/capture-corner-line-web.mjs",
        "scripts/corner-line-{native,web}-proof.tsx",
        // The lifecycle glyph runbook invokes capture by path; esbuild and Gradle select these entries.
        "scripts/capture-lifecycle-glyph-web.mjs",
        "scripts/lifecycle-glyph-{native,web}-proof.tsx",
        "scripts/transcript-events-native-proof.tsx",
        // Browser bundling and the temporary Metro main select these proof entries by path.
        "scripts/disclosure-rows-{browser,native}-proof.tsx",
        "scripts/transcript-dividers-{browser,native}-proof.tsx",
        "scripts/lifecycle-rows-a-native-proof.tsx",
        "scripts/ci-accordion-proof.tsx",
        "scripts/tray-empty-proof.tsx",
        "scripts/tray-inline-native-proof.tsx",
        "scripts/needs-you-badge-proof.tsx",
        "scripts/desktop-rail-mine-proof.tsx",
        "scripts/desktop-ui-fixes-proof.tsx",
        "scripts/room-card-spacing-proof.tsx",
        "scripts/render-room-list-proof.mjs",
        // The quiet row actions runbook invokes these CLIs; esbuild and Gradle select entries by path.
        "scripts/render-quiet-row-actions-proof.mjs",
        "scripts/capture-quiet-row-actions-web.mjs",
        "scripts/quiet-row-actions-{native,web}-proof.tsx",
        // The corner swipe rest runbook invokes these CLIs; esbuild selects the entry by path.
        "scripts/render-corner-swipe-rest-proof.mjs",
        "scripts/capture-corner-swipe-rest-web.mjs",
        "scripts/corner-swipe-rest-web-proof.tsx",
        // esbuild and Gradle load the header alignment proof entries by path.
        "scripts/render-header-alignment-proof.mjs",
        "scripts/header-alignment-proof/{native,web}.tsx",
        "scripts/room-list-proof.tsx",
        "scripts/room-list-corner-longpress-proof.tsx",
        "scripts/room-list-gestures-proof.tsx",
        "scripts/room-list-blank-proof.tsx",
        "scripts/notification-landing-proof.tsx",
        "scripts/cross-tab-signout-proof.ts",
        "scripts/cross-tab-storage-proof.tsx",
        "scripts/render-agent-profile-voice-proof.mjs",
        "scripts/agent-profile-voice-proof.tsx",
        "scripts/agent-profile-voice-native-proof.tsx",
        "scripts/verify-agent-profile-native-heading.mjs",
        "scripts/render-consolidated-board-proof.mjs",
        "scripts/consolidated-board-proof.tsx",
        "scripts/android-splash-theme-proof.js",
        "scripts/corner-sections-proof.tsx",
        "scripts/corner-overview-proof.tsx",
        "scripts/corner-dropdown-proof.tsx",
        "scripts/new-corner-dialog-proof.tsx",
        "scripts/room-repo-choice-proof.tsx",
        "scripts/room-sheet-height-proof.tsx",
        // person-invite.browser.test.ts bundles this entry by path.
        "scripts/person-invite-proof.tsx",
        "scripts/build-subscriptions-frame.ts",
        "scripts/subscriptions-frame.tsx",
        "scripts/composer-dictation-proof.tsx",
        "scripts/composer-web-dictation-proof.tsx",
        "scripts/composer-server-dictation-proof.tsx",
        "scripts/prove-server-dictation.mjs",
        "scripts/composer-desktop-voice-entry-proof.tsx",
        // The browser regression bundles this entry by path through esbuild.
        "scripts/call-feedback-proof.tsx",
        "scripts/desktop-sheet-width-proof.tsx",
        "scripts/voice-resume-proof.tsx",
        "scripts/composer-waveform-native-proof.tsx",
        // Gradle bundles the pinned composer screenshot fixture via entryFile.
        "scripts/composer-pin-row-native-proof.tsx",
        "scripts/composer-v4-native-proof.tsx",
        "scripts/composer-v4-web-proof.tsx",
        "scripts/composer-retry-wrap-web-proof.tsx",
        "scripts/composer-retry-wrap-native-proof.tsx",
        "scripts/answer-prefill-proof.tsx",
        "scripts/sign-in-notice-native-proof.tsx",
        "scripts/composer-waveform-web-proof.tsx",
        "scripts/voice-multi-tips-native-proof.tsx",
        "scripts/multi-human-silence-native-proof.tsx",
        "scripts/runnable-native-proof.tsx",
        // Selected as Metro's temporary entry by evidence/interactive-label/README.md.
        "scripts/interactive-label-native-proof.tsx",
        "scripts/call-error-android-proof.tsx",
        // Selected as Expo's main entry for the isolated Hermes cancellation proof.
        "scripts/livekit-abort-native-proof.tsx",
        "scripts/voice-delivery-android-proof.tsx",
        "scripts/voice-multi-tips-web-proof.tsx",
        "scripts/composer-recorder-proof.tsx",
        "scripts/prove-browser-recorder.mjs",
        "scripts/composer-conversation-proof.tsx",
        "scripts/voice-call-proof.tsx",
        "scripts/composer-tags-proof.tsx",
        "scripts/composer-hint-center-native.tsx",
        "scripts/composer-agent-placeholder-native.tsx",
        "scripts/composer-hint-center-web.tsx",
        "scripts/build-composer-hint-center-web.ts",
        "scripts/composer-dictation-correction-proof.tsx",
        "scripts/channel-suggestion-proof.tsx",
        "scripts/page-headers-proof.tsx",
        "scripts/design-proof.tsx",
        "scripts/connect-app-nav-inset-proof.tsx",
        "scripts/workbench-nav-inset-proof.tsx",
        "scripts/connectors-restructure-frames.tsx",
        "scripts/star-prompt-proof.tsx",
        "scripts/push-sensitivity-proof.tsx",
        "scripts/wallet-dm-proof.tsx",
        "scripts/connector-switch-proof.tsx",
        "scripts/scheduled-work-proof.tsx",
        "scripts/workflow-run-proof.tsx",
        "scripts/member-picker-nav-inset-proof.tsx",
        "scripts/new-room-nav-gap-proof.tsx",
        "scripts/agent-profile-usage-native-proof.tsx",
        "scripts/agent-usage-refresh-native-proof.tsx",
        "scripts/usage-truth-native-proof.tsx",
        // Invoked by path or selected as Metro aliases for the Android screenshot proof.
        "scripts/search-cell-proof/*.{cjs,ts,tsx}",
      ],
      "project": [
        "sources/**/*.{js,ts,tsx}",
        "scripts/**/*.{js,cjs,mjs,ts,tsx}",
        "plugins/**/*.js",
        "*.config.js",
      ],
    },
    "apps/body": {
      // The Squire facade is spawned by path from squire-host.ts, outside the
      // JavaScript module graph Knip can follow.
      "entry": [
        "src/{index,cli,recovery-cli,squire-facade}.ts",
        "scripts/measure-turn-phases.ts",
        "vitest.live.config.ts",
      ],
    },
    "apps/server": {
      // The cutover script imports built modules by their container paths.
      "paths": {
        "/app/apps/auth/dist/*": ["../auth/src/*"],
        "/app/apps/server/dist/*": ["src/*"],
      },
      // These are copied to an operator host and executed during database
      // cutover; they are intentionally not package.json commands.
      "entry": [
        "src/{index,measure-cli,corner-cleanup-cli}.ts",
        "scripts/{copy-postgres-data,verify-fly-cutover}.mjs",
      ],
    },
    "packages/buzz-client": {
      "entry": ["src/index.ts"],
    },
  },
}
