    "id": "src/agent-command.ts:routeTaggedLifecycleCommand:wrapper:4c2a67aa215ba167",
    "file": "apps/server/src/agent-command.ts",
    "kind": "wrapper",
    "template": "line('has no failed turn to retry')",
    "literals": [
      "' '",
