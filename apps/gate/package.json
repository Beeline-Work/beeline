{
  "name": "@buzzy/gate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/worker.js",
  "scripts": {
    "worker": "node --import tsx src/worker.ts",
    "provisioning": "node --import tsx src/provisioning.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pretest:live": "npm run build -w @buzzy/nostr",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@buzzy/nostr": "*"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
