+// Local diagnostic instrument; removed after capture.
+if (latencyFrameTraceEnabled) {
+  let previousTick = performance.now();
+  setInterval(() => {
+    const now = performance.now();
+    const elapsed = now - previousTick;
+    previousTick = now;
+    if (elapsed > 65) console.warn('[BACK_JS_GAP] ' + JSON.stringify({at: Date.now(), elapsed, excess: elapsed - 16}));
+  }, 16);
+}
