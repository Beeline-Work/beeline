      "default": "./dist/composio.js"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "import": "./dist/phone.js",
      "default": "./dist/phone.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js",
      "default": "./dist/daemon.js"
    },
    "./scheduled-prompts": {
      "types": "./dist/scheduled-prompts.d.ts",
      "import": "./dist/scheduled-prompts.js",
      "default": "./dist/scheduled-prompts.js"
    },
    "./agent-access": {
      "types": "./dist/agent-access.d.ts",
      "import": "./dist/agent-access.js",
      "default": "./dist/agent-access.js"
    },
    "./agent-grants": {
      "types": "./dist/agent-grants.d.ts",
      "import": "./dist/agent-grants.js",
      "default": "./dist/agent-grants.js"
    },
    "./connector-offers": {
      "types": "./dist/connector-offers.d.ts",
