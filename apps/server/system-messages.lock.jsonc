  {
    "id": "src/phone-service.ts:PhoneService.updateAgentYolo:systemLine:d86979a0c22d2c96",
    "file": "apps/server/src/phone-service.ts",
    "kind": "systemLine",
    "template": "systemLine(database, {\n    roomId: room.room_id,\n    subject: { kind: 'person', id: viewerId, name: agent.viewer_name },\n    verb: input.enabled ? 'turned yolo on for' : 'turned yolo off for',\n    object: { text: agent.agent_name, id: input.agentId },\n    consequence: input.enabled\n        ? 'grant requests are now approved automatically'\n        : 'grant requests now ask before running',\n    cardType: 'agent-yolo',\n    card: { agentId: input.agentId, enabled: input.enabled },\n})",
    "literals": [
      "'agent-yolo'",
      "'grant requests are now approved automatically'",
      "'grant requests now ask before running'",
      "'invite-only'",
      "'person'",
      "'public'",
      "'turned yolo off for'",
      "'turned yolo on for'",
      "`SELECT a.owner_id,agent.name agent_name,viewer.name viewer_name,\n                workspace.visibility workspace_visibility\n         FROM agents a\n         JOIN identities agent ON agent.id=a.agent_id\n         JOIN memberships m ON m.identity_id=a.agent_id\n           AND m.workspace_id=$2 AND m.room_id IS NULL AND m.removed_at IS NULL\n         JOIN identities viewer ON viewer.id=$3\n         JOIN workspaces workspace ON workspace.id=$2\n         WHERE a.agent_id=$1`"
    ],
    "occurrences": 1
  },
