{
  "name": "@beeline/api-contract",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./phone": {
      "types": "./dist/phone.d.ts",
      "import": "./dist/phone.js",
      "default": "./dist/phone.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js",
      "default": "./dist/daemon.js"
    },
    "./scheduled-prompts": {
      "types": "./dist/scheduled-prompts.d.ts",
      "import": "./dist/scheduled-prompts.js",
      "default": "./dist/scheduled-prompts.js"
    },
    "./agent-grants": {
      "types": "./dist/agent-grants.d.ts",
      "import": "./dist/agent-grants.js",
      "default": "./dist/agent-grants.js"
    },
    "./surface-capabilities": {
      "types": "./dist/surface-capabilities.d.ts",
      "import": "./dist/surface-capabilities.js",
      "default": "./dist/surface-capabilities.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
