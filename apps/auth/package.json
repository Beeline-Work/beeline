{
  "name": "@beeline/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./environment": {
      "types": "./dist/environment.d.ts",
      "import": "./dist/environment.js",
      "default": "./dist/environment.js"
    },
    "./github": {
      "types": "./dist/github.d.ts",
      "import": "./dist/github.js",
      "default": "./dist/github.js"
    },
    "./oidc": {
      "types": "./dist/oidc.d.ts",
      "import": "./dist/oidc.js",
      "default": "./dist/oidc.js"
    },
    "./phone-github-ticket": {
      "types": "./dist/phone-github-ticket.d.ts",
      "import": "./dist/phone-github-ticket.js",
      "default": "./dist/phone-github-ticket.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js",
      "default": "./dist/store.js"
    }
  },
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "dev:emulator": "node --import tsx scripts/oidc-emulator.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.emulator.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@beeline/api-contract": "*",
    "@beeline/buzz-client": "*",
    "@beeline/nostr": "*",
    "fastify": "^5.1.0",
    "jose": "^4.15.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
