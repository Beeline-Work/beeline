{
  "name": "@beeline/buzz-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pretest:live": "npm run build -w @beeline/nostr && npm run build -w @beeline/buzz-client",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@beeline/nostr": "*",
    "@noble/hashes": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
