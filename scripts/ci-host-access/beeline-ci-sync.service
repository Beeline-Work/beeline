[Unit]
Description=Install Beeline CI scripts only from merged upstream main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /opt/beeline-ci/sync.py
UMask=0022
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=600
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
