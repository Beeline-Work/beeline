{
  "name": "buzzy",
  "version": "0.0.0",
  "private": true,
  "description": "The merge you hold from your phone. See spec.md.",
  "workspaces": [
    "apps/api",
    "apps/auth",
    "apps/body",
    "apps/gate",
    "apps/push-gateway",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:invite-web": "esbuild relay-stack/web/join/invite-source.js --bundle --format=iife --minify --platform=browser --target=es2022 --alias:@beeline/buzz-client=./packages/buzz-client/src/index.ts --alias:@beeline/nostr=./packages/nostr/src/index.ts --outfile=relay-stack/web/join/invite.js",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && npm run typecheck --prefix apps/mobile",
    "test": "turbo run test",
    "stack:up": "docker compose -f relay-stack/compose.yml up -d",
    "stack:down": "docker compose -f relay-stack/compose.yml down -v",
    "smoke": "node --import tsx scripts/smoke.ts",
    "test:deploy": "node --test scripts/deploy-relay-host.test.mjs",
    "prove": "node --import tsx scripts/money-shot.ts",
    "install:beeline": "bash scripts/install-beeline.sh",
    "bundle:beeline": "node scripts/build-beeline-bundle.mjs",
    "verify:beeline-install": "node scripts/verify-beeline-install.mjs",
    "mobile:install": "npm install --prefix apps/mobile",
    "mobile:web": "npm run web --prefix apps/mobile",
    "mobile:typecheck": "npm run typecheck --prefix apps/mobile"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "npm@10.8.0"
}
