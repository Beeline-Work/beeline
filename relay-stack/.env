# Isolated Buzz relay stack for the Phase-0 merge-gate proof.
# Generated secrets — this stack is local-only, bound to 127.0.0.1.
BUZZ_IMAGE=ghcr.io/block/buzz:main

# Host the relay serves. NIP-98 `u`-tag scheme is derived from this (ws -> http).
# The community for this exact authority (host:port) is seeded in Postgres.
RELAY_URL=ws://127.0.0.1:3010
BUZZ_RELAY_URL=ws://10.0.2.2:3010

BUZZ_HTTP_PORT=3010
BUZZY_AUTH_NODE_ENV=development
BUZZY_MATERIALIZER_NODE_ENV=development
BUZZY_INDEXER_PUBLIC_ORIGIN=http://10.0.2.2:3010

POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=bf2beed0bc52dd80d4ea8039bfec5d49
REDIS_PASSWORD=cadd5fd7133431627bd7c4510babb22a
BUZZ_S3_ACCESS_KEY=46590d184a064d767fac150a
BUZZ_S3_SECRET_KEY=1dda15cd2278f274ca787899ca52efc3
BUZZ_S3_BUCKET=buzz-media
BUZZ_S3_ADDRESSING_STYLE=path

# Known HMAC secret for the git pre-receive policy hook (>=32 chars).
BUZZ_GIT_HOOK_HMAC_SECRET=4e998683a9ee982fe263e06aed2ee2ebe1204114161a3953da58849b6ab16036
