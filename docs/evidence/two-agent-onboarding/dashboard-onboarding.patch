+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { renderOnboarding } from '../public/onboarding-view.js';
+test('onboarding renders branch counts and null-aware timings safely', () => {
+  assert.equal(renderOnboarding(null), '');
+  const html = renderOnboarding({ from:'2026-10-26', through:'2026-10-26', splits:[
+    {option:'D',steps:[{event:'game_posted',count:2,previousEvent:'option_picked',medianTimeMs:1500,medianDurationMs:null}]},
+    {option:'<img>',steps:[]},
+  ]});
+  assert.match(html, /First choice D/); assert.match(html, /1\.5 s/);
+  assert.match(html, /&lt;img&gt;/); assert.doesNotMatch(html, /<img>/);
+});
