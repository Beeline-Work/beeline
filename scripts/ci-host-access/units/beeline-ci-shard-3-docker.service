[Unit]
Description=Isolated rootless Docker for beeline-ci-shard-3
After=network-online.target
[Service]
User=beeline-ci-shard-3
Group=beeline-ci-shard-3
SupplementaryGroups=
Slice=beeline-ci3.slice
RootDirectory=/var/lib/beeline-ci-shard-3/root
MountAPIVFS=yes
BindReadOnlyPaths=/usr /etc/ssl/certs /etc/ld.so.cache /opt/beeline-ci
BindPaths=/var/lib/beeline-ci-shard-3/state:/ci
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/ci /tmp /var/tmp /run
PrivateTmp=yes
ProtectKernelTunables=no
ProtectControlGroups=yes
UMask=0077
Environment=HOME=/ci/home XDG_RUNTIME_DIR=/ci/run PYTHONDONTWRITEBYTECODE=1
MemoryMax=12G
CPUQuota=300%
Nice=10
TasksMax=4096
TimeoutStopSec=60
ExecStart=/usr/bin/rootlesskit --state-dir=/ci/run/rootlesskit --net=slirp4netns --disable-host-loopback --port-driver=builtin --copy-up=/etc --copy-up=/run /usr/bin/dockerd --rootless --host=unix:///ci/run/docker.sock --data-root=/ci/docker --exec-root=/ci/run/docker-exec --pidfile=/ci/run/docker.pid --storage-driver=overlay2
Environment=_DOCKERD_ROOTLESS_CHILD=1
Restart=on-failure
RestartSec=10
